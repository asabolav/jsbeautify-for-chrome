{
  "manifest_version": 3,
  "name": "JS Beautify In-Tab",
  "description": "Automatically beautify JavaScript files opened in Chrome and render them in the same tab.",
  "version": "1.1.0",
  "icons": {
    "48": "src/assets/icon_48.png",
    "128": "src/assets/icon_128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "JS Beautify",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}